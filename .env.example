# Postgres (Neon or local) — required
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better Auth — required (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — optional; button appears when set.
# Google Cloud Console → OAuth client (Web application):
#   authorized origin:      http://localhost:3000
#   authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple Sign-In — optional; button appears when set. Requires a paid Apple
# Developer account and an HTTPS return URL (no localhost — deployed only):
#   return URL: https://<your-domain>/api/auth/callback/apple
# APPLE_CLIENT_ID is the Services ID (e.g. com.beobeo.web.signin).
# APPLE_CLIENT_SECRET is a self-signed ES256 JWT (max 6-month validity) built
# from your Apple key — regenerate before expiry.
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Market data providers (phase 3)
TIINGO_API_KEY=""
ALPHA_VANTAGE_API_KEY=""
COINGECKO_API_KEY=""

# AI agent (phase 7)
ANTHROPIC_API_KEY=""
